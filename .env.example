# Salin menjadi .env (atau set di server). Tanpa WA_PROVIDER, WhatsApp nonaktif; simulator di menu WhatsApp tetap berfungsi.
PORT=3000
# ADMIN_PASSWORD=          # opsional: password awal admin (jika kosong dibuat acak dan dicetak di konsol)
# TRUST_PROXY=1            # wajib bila di belakang reverse proxy (Nginx/Caddy)

# --- WhatsApp: pilih salah satu penyedia ---
# WA_PROVIDER=meta         # WhatsApp Cloud API resmi dari Meta (disarankan)
# WA_VERIFY_TOKEN=         # bebas, dipakai saat mendaftarkan webhook di Meta
# WA_APP_SECRET=           # App Secret aplikasi Meta (untuk memverifikasi tanda tangan)
# WA_ACCESS_TOKEN=         # token akses permanen (System User)
# WA_PHONE_NUMBER_ID=      # ID nomor telepon WhatsApp Business

# WA_PROVIDER=fonnte       # gateway tidak resmi; risiko nomor diblokir WhatsApp
# FONNTE_TOKEN=
# WA_WEBHOOK_TOKEN=        # token acak; webhook: https://DOMAIN/api/wa/webhook?token=ISI_TOKEN

# WA_PROVIDER=waha         # WAHA (self-hosted, tidak resmi)
# WAHA_URL=http://localhost:3001
# WAHA_SESSION=default
# WAHA_API_KEY=
# WA_WEBHOOK_TOKEN=
